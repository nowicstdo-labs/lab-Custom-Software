# DATABASE CONFIGURATION (POSTGRESQL)
# Local Docker/Dev:
# DATABASE_URL="postgresql://astha_user:astha_secure_pass@localhost:5432/astha_diagnostic_db?schema=public"
#
# Cloud PostgreSQL Production Options:
# Supabase Pooler: DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Neon:            DATABASE_URL="postgresql://[USER]:[PASSWORD]@[EP_NAME].aws.neon.tech/[DBNAME]?sslmode=require"
# Render Postgres: DATABASE_URL="postgres://[USER]:[PASSWORD]@[HOST].render.com/[DBNAME]?sslmode=require"
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?schema=public&sslmode=require"

# APPLICATION CONFIGURATION
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# JWT AUTHENTICATION SECRETS & EXPIRATION
JWT_SECRET="<YOUR_SECURE_JWT_SECRET_KEY>"
JWT_ACCESS_SECRET="<YOUR_SECURE_JWT_ACCESS_SECRET>"
JWT_REFRESH_SECRET="<YOUR_SECURE_JWT_REFRESH_SECRET>"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# CORS & SECURITY ALLOWLIST
CORS_ORIGIN="*"

# EMAIL PROVIDER CONFIGURATION (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="<SMTP_USERNAME>"
SMTP_PASSWORD="<SMTP_PASSWORD>"
SMTP_FROM="no-reply@asthadiagnostic.com"

# WHATSAPP BUSINESS API PROVIDER CONFIGURATION
WHATSAPP_API_URL="https://api.whatsapp.com/v1/messages"
WHATSAPP_API_TOKEN="<WHATSAPP_TOKEN_PLACEHOLDER>"

# SECURE FILE STORAGE CONFIGURATION
FILE_STORAGE_TYPE="local"
FILE_STORAGE_ENDPOINT="http://localhost:9000"
FILE_STORAGE_BUCKET="astha-medical-files"
FILE_STORAGE_ACCESS_KEY="<STORAGE_ACCESS_KEY>"
FILE_STORAGE_SECRET_KEY="<STORAGE_SECRET_KEY>"
