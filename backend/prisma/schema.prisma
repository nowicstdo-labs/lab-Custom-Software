generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  RECEPTIONIST
  LAB_TECHNICIAN
  DOCTOR
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum SampleStage {
  SAMPLE_COLLECTED
  SAMPLE_RECEIVED
  PROCESSING
  TESTING
  RESULT_ENTERED
  COMPLETED
}

enum ReportStage {
  DRAFT
  TECHNICIAN_COMPLETED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  FINAL
}

enum Priority {
  ROUTINE
  URGENT
  STAT
}

enum ResultFlag {
  NORMAL
  HIGH
  LOW
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(PATIENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile PatientProfile?
  staffProfile   StaffProfile?
  doctorProfile  DoctorProfile?
  notifications  Notification[]
  auditLogs      AuditLog[]
  refreshTokens  RefreshToken[]

  @@index([email])
  @@index([role])
}

model PatientProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  patientId             String   @unique
  dob                   String?
  gender                String?
  bloodGroup            String?
  address               String?
  alternateNumber       String?
  emergencyName         String?
  emergencyRelationship String?
  emergencyPhone        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  appointments Appointment[]
  samples      Sample[]
  reports      LabReport[]
  invoices     Invoice[]
}

model StaffProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  employeeId  String   @unique
  department  String?
  designation String?
  joiningDate String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DoctorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  doctorId        String   @unique
  specialization  String
  qualification   String
  experienceYears Int      @default(0)
  consultationFee Float    @default(0.0)
  createdAt       DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  reports      LabReport[]
}

model Test {
  id              String   @id @default(uuid())
  testId          String   @unique
  testName        String
  category        String
  price           Float
  description     String?
  preparationInfo String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  parameters TestParameter[]
  bookings   Booking[]
  formulas   Formula[]
}

model TestParameter {
  id             String   @id @default(uuid())
  testId         String
  parameterName  String
  referenceRange String
  unit           String
  minVal         Float?
  maxVal         Float?
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())

  test        Test         @relation(fields: [testId], references: [id], onDelete: Cascade)
  testResults TestResult[]
}

model AppointmentSlot {
  id              String   @id @default(uuid())
  date            String
  timeSlot        String
  maxCapacity     Int      @default(10)
  currentBookings Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([date, timeSlot])
}

model Booking {
  id              String        @id @default(uuid())
  bookingId       String        @unique
  patientId       String
  testId          String
  appointmentDate String
  timeSlot        String
  price           Float
  status          BookingStatus @default(CONFIRMED)
  paymentStatus   PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  patient PatientProfile @relation(fields: [patientId], references: [id])
  test    Test           @relation(fields: [testId], references: [id])
  samples Sample[]
  report  LabReport?
  invoice Invoice?
}

model Appointment {
  id              String   @id @default(uuid())
  appointmentId   String   @unique
  patientId       String
  doctorId        String
  appointmentDate String
  timeSlot        String
  status          String   @default("Scheduled")
  symptoms        String?
  diagnosis       String?
  createdAt       DateTime @default(now())

  patient PatientProfile @relation(fields: [patientId], references: [id])
  doctor  DoctorProfile  @relation(fields: [doctorId], references: [id])
}

model Sample {
  id             String      @id @default(uuid())
  sampleId       String      @unique
  bookingId      String
  patientId      String
  sampleType     String
  barcodeToken   String      @unique
  priority       Priority    @default(ROUTINE)
  stage          SampleStage @default(SAMPLE_COLLECTED)
  collectionTime DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  booking     Booking      @relation(fields: [bookingId], references: [id])
  patient     PatientProfile @relation(fields: [patientId], references: [id])
  testResults TestResult[]
  labReports  LabReport[]
}

model TestResult {
  id          String     @id @default(uuid())
  sampleId    String
  parameterId String
  resultValue String
  statusFlag  ResultFlag @default(NORMAL)
  evaluatedAt DateTime   @default(now())

  sample    Sample        @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  parameter TestParameter @relation(fields: [parameterId], references: [id])
}

model LabReport {
  id                   String      @id @default(uuid())
  reportId             String      @unique
  bookingId            String      @unique
  sampleId             String
  patientId            String
  doctorId             String?
  technicianId         String?
  stage                ReportStage @default(DRAFT)
  remarks              String?
  qrVerificationToken String      @unique
  finalizedAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  booking          Booking            @relation(fields: [bookingId], references: [id])
  sample           Sample             @relation(fields: [sampleId], references: [id])
  patient          PatientProfile     @relation(fields: [patientId], references: [id])
  doctor           DoctorProfile?     @relation(fields: [doctorId], references: [id])
  reportParameters ReportParameter[]
  approvals        ReportApproval[]
}

model ReportParameter {
  id             String     @id @default(uuid())
  reportId       String
  parameterName  String
  resultValue    String
  referenceRange String
  unit           String
  statusFlag     ResultFlag @default(NORMAL)

  report LabReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ReportApproval {
  id              String      @id @default(uuid())
  reportId        String
  reviewerId      String
  status          ReportStage
  rejectionReason String?
  reviewedAt      DateTime    @default(now())

  report LabReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Formula {
  id           String   @id @default(uuid())
  formulaId    String   @unique
  formulaName  String
  targetTestId String
  expression   String
  parameters   String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  test Test @relation(fields: [targetTestId], references: [id])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  bookingId     String        @unique
  patientId     String
  totalAmount   Float
  discountAmount Float        @default(0.0)
  netAmount     Float
  paymentStatus PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  booking  Booking        @relation(fields: [bookingId], references: [id])
  patient  PatientProfile @relation(fields: [patientId], references: [id])
  items    InvoiceItem[]
  payments Payment[]
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  amount      Float

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id                   String        @id @default(uuid())
  paymentId            String        @unique
  invoiceId            String
  amount               Float
  paymentMethod        String
  transactionReference String?
  status               PaymentStatus @default(PAID)
  paidAt               DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  details      String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model FileAttachment {
  id           String   @id @default(uuid())
  resourceType String
  resourceId   String
  fileName     String
  fileUrl      String
  mimeType     String
  fileSize     Int
  uploadedBy   String
  createdAt    DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OTPVerification {
  id           String   @id @default(uuid())
  phoneOrEmail String
  otpHash      String
  expiresAt    DateTime
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
}
